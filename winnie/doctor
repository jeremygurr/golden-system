#!/usr/bin/env bash

simple_path=${c2_path:-~/p/simpleton2}
system_name=winnie
system_path=${system_path:-~/p/golden-system/$system_name}
alt_home=${alt_home:-~/alt-home}

if [[ ! -f $simple_path/c2 ]]; then
  echo "Missing c2. Either run this in the same folder as c2 or set c2_path to the folder containing it." >&2
  exit 1
fi

source $simple_path/c2 || exit 1

main() {

local \
  clean=${clean:-f} \
  clean_image=${clean_image:-f} \
  clean_home=${clean_home:-f} \
  update=${update:-f} \

begin_function

  identify_os || fail

  export DOCKER=docker

  export ALPINE_IMAGE=artifactory.aexp.com:443/dockerproxy/alpine:3.24.2
  export ALPINE_REPO=https://artifactory.aexp.com/artifactory/alpine-raw/
  export NO_PROXY=.aexp.com,localhost,127.0.0.1,192.168.0.1
  export HTTPS_PROXY=http://proxy.aexp.com:8080
  export HTTP_PROXY=http://proxy.aexp.com:8080

  if [[ $clean == t ]]; then
    log_verbose "Cleaning home folder at $alt_home"
    rm -rf $alt_home
    update=t
  fi

  mkdir -p $alt_home || fail

  pushd $simple_path &>/dev/null || fail
  clean=$clean_image \
  build_docker_util_image || fail
  popd &>/dev/null || fail

  image=harness \
    clean=$clean_image \
    base_folder=$system_path \
    dockerfile=$system_path/Dockerfile \
    build_args='HTTP_PROXY HTTPS_PROXY NO_PROXY' \
    docker_image_create_if_missing || fail

  if [[ ! -d $alt_home/.bashrc ]]; then
    log_verbose "Syncing home from util image to $alt_home..."
    $DOCKER run --rm --name transfer -u root -v $alt_home:/home.new harness rsync -a /home/ /home.new/ || fail
  fi

  if [[ ! -d $alt_home/.pi || $update == t ]]; then
    log_verbose "Building .pi in $alt_home"
    mkdir -p $alt_home/.pi/agent || fail
    cp pi-settings.json $alt_home/.pi/agent/settings.json || fail
  fi

  if [[ ! -d ~/repo ]]; then
    log_verbose "Building repo in $alt_home"
    mkdir ~/repo || fail
  fi

  if [[ ! -f $alt_home/profile || $update == t ]]; then
    log_verbose "Building profile in $alt_home"
    cat profile* >>$alt_home/profile || fail
  fi

  if ! grep GITHUB_TOKEN $alt_home/.bashrc &>/dev/null; then
    read -p "GITHUB_TOKEN=" -rs GITHUB_TOKEN && {
      echo '************'
      echo "export GITHUB_TOKEN='$GITHUB_TOKEN'" >>$alt_home/.bashrc || fail
      export GITHUB_TOKEN='$GITHUB_TOKEN'
    }
  fi

  if ! grep GITHUB_USER $alt_home/.bashrc &>/dev/null; then
    read -p "GITHUB_USER=" -r GITHUB_USER
    echo "export GITHUB_USER=$GITHUB_USER" >>$alt_home/.bashrc || fail
    export GITHUB_USER='$GITHUB_USER'
  fi

  if [[ ! -f $alt_home/init || $update == t ]]; then
    log_verbose "Building init in $alt_home"
    cp init $alt_home/ || fail
  fi

  if [[ ! -f $alt_home/bin/c2 || $update == t ]]; then
    log_verbose "Building c2 in $alt_home"
    cp $simple_path/c2 $alt_home/bin/c2 || fail
  fi

  if [[ ! -f ~/.bash_aliases || $update == t ]]; then
    log_verbose "Building .bash_aliases in $alt_home"
    echo "
 alias d=podman
 alias dl='podman logs --tail 100 -f'
 " >~/.bash_aliases
  fi

  if [[ ! -f $alt_home/.config/rpiv-web-tools/config.json ]]; then
    log_verbose "Building rpiv-web-tools in $alt_home"
    mkdir -p $alt_home/.config/rpiv-web-tools || fail
    cp ../common/rpiv-web-tools-config.json $alt_home/.config/rpiv-web-tools/config.json || fail
  fi
  
  name=main \
  docker_network_create_if_missing || fail

#  name=harness \
#    volumes="
#      $alt_home:/home
#      ~/repo:/repo
#      ~/work:/work
#      " \
#    envs="
#      HERDR_SOCKET_PATH=/work/herdr.sock
#      PROMPT_NAME=$system_name
#      COMMAND=herdr server
#      " \
#    image=harness \
#    background=f \
#    command="/bin/bash /home/init" \
#    docker_run_if_missing || fail
#

  if [[ ! -d $alt_home/searxng ]]; then
    log_verbose "Building searxng in $alt_home"
    mkdir $alt_home/searxng || fail
    cp ../common/searxng-settings.yml $alt_home/searxng/settings.yml || fail
  fi

  name=sear \
    volumes="$alt_home/searxng:/etc/searxng"
    envs='
      PROMPT_NAME=quarter-sear
      SEARXNG_BASE_URL=http://127.0.0.1:8080/
      {{http,https,all}_proxy,{HTTP,HTTPS,ALL}_PROXY}=http://127.0.0.1:3636
      ' \
    image=docker.io/searxng/searxng:2026.8.29-d226b78bc \
    background=t \
    network=main \
    docker_run_if_missing || fail

end_function
handle_return

}

main || exit 1

