#!/usr/bin/env bash

simple_path=${c2_path:-~/p/simpleton2}
DOCKER=${DOCKER:-docker}
alt_home=${alt_home:-~/alt-home}
system_name=winnie

source $simple_path/c2 || exit 1

echo "Launching sandbox..."
name=harness \
  volumes="
    $alt_home:/home
    ~/repo:/repo
    ~/work:/work
    " \
  envs="
    HERDR_SOCKET_PATH=/work/herdr.sock
    PROMPT_NAME=$system_name
    " \
  image=harness \
  background=f \
  command="/bin/bash /home/init" \
  docker_run_if_missing

