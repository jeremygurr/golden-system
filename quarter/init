#!/usr/bin/env bash

source /home/bin/c2

main() {

  set -u

  if [[ ! -f ~/.ssh/id_rsa ]]; then
    if [[ ! -d ~/.ssh ]]; then
      mkdir ~/.ssh
    fi
    ssh-keygen -mPEM -f ~/.ssh/id_rsa -N "" 
  fi

  source ~/.bashrc

  repo_path=/repo/sorcery-skills \
  repo=https://github.com/jeremygurr/sorcery-skills.git \
  skills_add_if_missing || return 1

  repo_path=/repo/matt-skills \
  repo=https://github.com/mattpocock/skills.git \
  skills='skills/engineering skills/productivity' \
  skills_add_if_missing || return 1

  if [[ "${COMMAND:-}" ]]; then
    /bin/bash -lc "$COMMAND"
  else
    /bin/bash -l
  fi

}

main

