simple_path=${c2_path:-/root/simpleton2}
quarter_path=${quarter_path:-/root/golden-system/quarter}

if [[ ! -f $simple_path/c2 ]]; then
  echo "Missing c2. Either run this in the same folder as c2 or set c2_path to the folder containing it." >&2
  exit 1
fi

source $simple_path/c2 || exit 1

main() {

local clean=${clean:-f}
begin_function

  local quarter_path=/root/golden-system/quarter
  local ssh_pubkey_path=$quarter_path/keys

  if [[ $clean == t && -e /home/util ]]; then
    rm -rf /home/util
  fi

  identify_os || fail

  uid=9999 \
  user=util    user_create_if_missing || fail

  local key_path=keys
  user=jgurr   user_create_if_missing || fail
  user=jmgurr  user_create_if_missing || fail
  user=divcity user_create_if_missing || fail

  mkdir -p /repo /work || fail

  packages=podman install_if_missing || fail
  export DOCKER=podman

  cd $simple_path || fail
  build_docker_util_image || fail

  image=harness \
    base_folder=$quarter_path \
    dockerfile=$quarter_path/Dockerfile \
    docker_image_create_if_missing || fail

  if [[ ! -d /home/util/.pi ]]; then
    mkdir -p /home/util/.pi/agent || fail
    $DOCKER run --rm --name transfer -u root -v /home/util:/home.new -e COMMAND="rsync -a /home/ /home.new/" harness || fail
    cp pi-settings.json /home/util/.pi/agent/settings.json || fail
    chown -R util /home/util || fail
  fi

end_function
handle_return

}

main || exit 1

