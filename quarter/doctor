simple_path=${c2_path:-/root/simpleton2}
quarter_path=${quarter_path:-/root/golden-system/quarter}

if [[ ! -f $simple_path/c2 ]]; then
  echo "Missing c2. Either run this in the same folder as c2 or set c2_path to the folder containing it." >&2
  exit 1
fi

if [[ $USER != root ]]; then
  log_fatal "This script should be run as root"
  exit 1
fi

source $simple_path/c2 || exit 1

main() {

local \
  clean=${clean:-f} \
  update=${update:-f} \
  clean_image=${clean_image:-f} \
  clean_home=${clean_home:-f} \

begin_function

  local quarter_path=/root/golden-system/quarter
  local ssh_pubkey_path=$quarter_path/keys

  identify_os || fail

  uid=9999 \
  clean=$clean_home user=util    user_create_if_missing || fail

  local key_path=keys
  user=jgurr   user_create_if_missing || fail
  user=jmgurr  user_create_if_missing || fail
  user=divcity user_create_if_missing || fail

  mkdir -p /repo /work || fail

  packages=podman install_if_missing || fail
  export DOCKER=podman

  pushd $simple_path || fail
  clean=$clean_image \
  build_docker_util_image || fail
  popd

  image=harness \
    clean=$clean_image \
    base_folder=$quarter_path \
    dockerfile=$quarter_path/Dockerfile \
    docker_image_create_if_missing || fail

  if [[ ! -d /home/util/.pi ]]; then
    mkdir -p /home/util/.pi/agent || fail
    $DOCKER run --rm --name transfer -u root -v /home/util:/home.new -e COMMAND="rsync -a /home/ /home.new/" harness || fail
    cp pi-settings.json /home/util/.pi/agent/settings.json || fail

    if ! grep OPENROUTER_API_KEY /home/util/.bashrc &>/dev/null; then
      read -p "OPENROUTER_API_KEY=" -rs OPENROUTER_API_KEY && {
        echo '************'
        echo "export OPENROUTER_API_KEY='$OPENROUTER_API_KEY'" >>/home/util/.bashrc || return 1
        export OPENROUTER_API_KEY='$OPENROUTER_API_KEY'
      }
    fi
    if ! grep GITHUB_TOKEN /home/util/.bashrc &>/dev/null; then
      read -p "GITHUB_TOKEN=" -rs GITHUB_TOKEN && {
        echo '************'
        echo "export GITHUB_TOKEN='$GITHUB_TOKEN'" >>/home/util/.bashrc || return 1
        export GITHUB_TOKEN='$GITHUB_TOKEN'
      }
    fi

  fi

  chown -R util /home/util /repo /work || fail

  if [[ ! -f /usr/local/bin/herdr ]]; then
    curl -fsSL https://herdr.dev/install.sh -o /tmp/herdr-install.sh
    sh /tmp/herdr-install.sh
    install -m 755 "$HOME/.local/bin/herdr" /usr/local/bin/herdr
  fi
  
  if [[ ! -f ~/.bash_aliases || $clean == t ]]; then
    echo "
 alias d=podman
 alias dl='podman logs --tail 100 -f'
 " >~/.bash_aliases
  fi

  name=harness \
    volumes="
      /home/util:/home
      /repo:/repo
      /work:/work" \
    envs='HERDR_SOCKET_PATH=/work/herdr.sock
COMMAND="herdr server"' \
    image=harness \
    background=t \
    docker_run_if_missing || fail

  chmod 666 /work/herdr* || fail

end_function
handle_return

}

main || exit 1

