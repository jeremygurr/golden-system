#!/usr/bin/env bash

source /home/bin/c2

main() {
  local update=${update:-f} clean=${clean:-f}

  set -u

  if [[ ! -f ~/.ssh/id_rsa ]]; then
    if [[ ! -d ~/.ssh ]]; then
      mkdir ~/.ssh
    fi
    ssh-keygen -mPEM -f ~/.ssh/id_rsa -N "" 
  fi

  if [[ ${PROMPT_NAME:-} ]]; then
    echo "$PROMPT_NAME" >~/prompt_name
  fi

  source ~/.bashrc

  repo_path=/repo/sorcery-skills \
  repo=https://github.com/jeremygurr/sorcery-skills.git \
  repo_skills_add_if_missing || return 1

  repo_path=/repo/matt-skills \
  repo=https://github.com/mattpocock/skills.git \
  skills='skills/engineering skills/productivity' \
  repo_skills_add_if_missing || return 1

  repo=kunchenguid/lavish-axi \
  skills=lavish \
  npx_skills_add_if_missing || return 1

  if [[ $update == t ]]; then
    pi update
    pi update --extensions
  fi

  if [[ ! -f /home/.git-credentials ]]; then
    git config --global credential.helper store || fail
    echo "https://divcity:$GITHUB_TOKEN" >~/.git-credentials || fail
  fi

  if [[ "${COMMAND:-}" ]]; then
    /bin/bash -lc "$COMMAND"
  else
    /bin/bash -l
  fi

}

main

